    public void updatePagination() {
        paginatedResults = new List<tocsubscriber__c>();
        if (accountidset.isEmpty()) return;

        Integer offsetVal = (currentPage - 1) * pageSize;
        String escapedSearch = String.escapeSingleQuotes(searchString);
        String searchPattern = '%' + escapedSearch + '%';

        String baseQuery = 'SELECT Id, Billing_Address__c, Account_Number__c, Name, Name__c ' +
            		   		'FROM tocsubscriber__c WHERE Account__c IN (SELECT Id FROM Account ' +
                            'WHERE Id IN :accountidset OR ParentId IN :accountidset OR Parent.ParentId IN :accountidset) ' +
                            'AND Account_Number__c != null';
		System.debug('updatePagination baseQuery Value' +baseQuery);
        if (String.isNotBlank(searchString)) {
            baseQuery += ' AND (Billing_Address__c LIKE \'' + searchPattern + '\' ' +
                     'OR Account_Number__c = \'' + escapedSearch + '\' ' +
                     'OR Name = \'' + escapedSearch + '\' ' +
                     'OR Name__c LIKE \'' + searchPattern + '\')';
        }

        baseQuery += ' LIMIT ' + pageSize + ' OFFSET ' + offsetVal;
		
        System.debug('updatePagination baseQuery Value updated' +baseQuery);
        paginatedResults = Database.query(baseQuery);
		
        System.debug('updatePagination paginatedResults Value' +paginatedResults);
        
    }

    public void nextPage() {
        system.debug('nextPage');
        if (currentPage < totalPages) {
            currentPage++;
            updatePagination();
        }
    }

    public void previousPage() {
        system.debug('previousPage');
        if (currentPage > 1) {
            currentPage--;
            updatePagination();
        }
    }

