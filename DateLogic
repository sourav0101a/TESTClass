@isTest(SeeAllData = false)
public class CustomBilltoLookupcontrollerTest {

    @TestSetup
    static void setupData() {
        // Accounts with Parent-Child
        Account acc1 = new Account(
            Name='testwave2account',
            tfcmCustomerStatus__c='Active',
            Segment__c='Central Bank',
            Credit_Check_Status__c='Not Started',
            TDO_Status__c='Not Started',
            Legal_Entity__c=true,
            ShippingCity='New York',
            ShippingStreet='123',
            ShippingPostalCode='456',
            ShippingCountry='United States',
            AccountNumber='A-1234571'
        );
        insert acc1;

        Account acc2 = new Account(
            Name='testwave2account',
            tfcmCustomerStatus__c='Active',
            Segment__c='Central Bank',
            Credit_Check_Status__c='Not Started',
            TDO_Status__c='Not Started',
            Legal_Entity__c=true,
            ShippingCity='New York',
            ShippingStreet='123',
            ShippingPostalCode='456',
            ShippingCountry='United States',
            AccountNumber='A-1234572',
            ParentId=acc1.Id
        );
        insert acc2;

        // Contact
        Id contactRTId = Schema.SObjectType.Contact.getRecordTypeInfosByName().get('TSales Contact').getRecordTypeId();
        Contact contact = new Contact(
            RecordTypeId = contactRTId,
            LastName='UnitTest Contact',
            tocContactStatus__c='Current User',
            Email='abc@tr.com',
            Salutation='Mr',
            FirstName='Name',
            AccountId=acc2.Id
        );
        insert contact;

        // tocSubscriber
        tocSubscriber__c subscriber = new tocSubscriber__c(
            Name__c='1',
            StreetAddress__c='195 Broadway',
            City__c='New York',
            State_Province__c='New York',
            Postal_Code__c='10021',
            Country__c='United States',
            Billing_Type__c='Billing',
            Name='bill1',
            Account_Status__c='Active',
            Account__c=acc2.Id,
            Account_Number__c='A-12345',
            Sub_Account_Number__c='150',
            Bill_Contact_Payer__c=contact.Id
        );
        insert subscriber;
    }

    @isTest
    static void test_Controller_FullFlow() {
        Account acc2 = [SELECT Id, ParentId FROM Account WHERE ParentId != null LIMIT 1];

        Test.startTest();
        PageReference pageRef = Page.CustomBilltoLookup;
        Test.setCurrentPage(pageRef);
        ApexPages.currentPage().getParameters().put('accid', acc2.Id);
        ApexPages.currentPage().getParameters().put('lksrch', 'A-12345');

        CustomBilltoLookupcontroller controller = new CustomBilltoLookupcontroller();

        controller.search();
        controller.updatePagination();
        controller.nextPage();
        controller.previousPage();

        // Set search string and retest
        controller.searchString = 'A-12345';
        controller.updatePagination();

        // Getters
        ApexPages.currentPage().getParameters().put('frm', 'formValue');
        ApexPages.currentPage().getParameters().put('txt', 'textValue');
        String formVal = controller.getFormTag();
        String txtVal = controller.getTextBox();

        System.assertEquals('formValue', formVal);
        System.assertEquals('textValue', txtVal);
        System.assertNotEquals(null, controller.paginatedResults);

        Test.stopTest();
    }

    @isTest
    static void test_Controller_NoAccId() {
        Test.startTest();
        PageReference pageRef = Page.CustomBilltoLookup;
        Test.setCurrentPage(pageRef);

        CustomBilltoLookupcontroller controller = new CustomBilltoLookupcontroller();
        controller.search();
        controller.updatePagination();
        controller.nextPage();
        controller.previousPage();
        Test.stopTest();
    }
}
